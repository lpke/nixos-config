+  public reloadConfig(): boolean {
+    if (this.isStaleDriver() || this.entered)
+      throw new Error("Krohnkite is busy; retry after the current window operation.");
+    if (this.workspace.stackingOrder.some(client => client.move || client.resize))
+      throw new Error("Finish moving or resizing the window before reloading.");
+    const previousLog = LOG;
+    const previous = KWINCONFIG;
+    let candidate: KWinConfig;
+    try {
+      candidate = new KWinConfig();
+      for (const key of Object.keys(previous) as Array<keyof KWinConfig>) {
+        if ((key === "layoutPerActivity" || key === "layoutPerDesktop" || key.indexOf("dock") === 0) &&
+            JSON.stringify(previous[key]) !== JSON.stringify(candidate[key]))
+          throw new Error(`Changing ${key} requires an explicit Krohnkite restart.`);
+      }
+    } catch (error) {
+      LOG = previousLog;
+      throw error;
+    }
+    if (JSON.stringify(previous) === JSON.stringify(candidate)) return false;
+    // Disabled layouts can still be selected in an existing desktop. Keep their
+    // factories and instances until the user switches layouts; only cycling order
+    // and defaults for new surfaces change.
+    candidate.layoutFactories = Object.assign({}, previous.layoutFactories, candidate.layoutFactories);
+    this.entered = true;
+    try {
+      CONFIG = KWINCONFIG = candidate;
+      this.engine.reloadConfig();
+      this.engine.arrange(this);
+    } catch (error) {
+      CONFIG = KWINCONFIG = previous;
+      LOG = previousLog;
+      this.engine.reloadConfig();
+      this.engine.arrange(this);
+      throw error;
+    } finally {
+      this.entered = false;
+    }
+    return true;
+  }
