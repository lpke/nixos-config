+void ActivationTest::testSwitchToWindowSkipsDeleted()
+{
+#if KWIN_BUILD_X11
+    QFETCH(int, direction);
+    QFETCH(QPoint, targetPosition);
+    QFETCH(QPoint, deletedPosition);
+    stackScreensHorizontally();
+
+    Test::XdgToplevelWindow source;
+    QVERIFY(source.show());
+    source.m_window->move(QPoint(500, 500));
+
+    Test::XdgToplevelWindow target;
+    QVERIFY(target.show());
+    target.m_window->move(targetPosition);
+
+    // Reproduce the retained X11 launcher between two live Wayland windows.
+    // Unlike an unmapped Wayland toplevel, it still wants tab focus after close.
+    Test::XcbConnectionPtr connection = Test::createX11Connection();
+    QVERIFY(!xcb_connection_has_error(connection.get()));
+    X11Window *deleted = createX11Window(connection.get(), Rect(deletedPosition, QSize(100, 100)));
+    QVERIFY(deleted);
+    deleted->move(deletedPosition);
+    deleted->ref();
+    const auto cleanup = qScopeGuard([deleted] { deleted->unref(); });
+    QSignalSpy closedSpy(deleted, &Window::closed);
+    xcb_destroy_window(connection.get(), deleted->window());
+    xcb_flush(connection.get());
+    QVERIFY(closedSpy.wait());
+    QVERIFY(deleted->isDeleted());
+    QVERIFY(deleted->wantsTabFocus());
+    QVERIFY(workspace()->stackingOrder().contains(deleted));
+
+    workspace()->activateWindow(source.m_window);
+    QCOMPARE(workspace()->activeWindow(), source.m_window);
+    workspace()->switchWindow(Workspace::Direction(direction));
+    QCOMPARE(workspace()->activeWindow(), target.m_window);
+
+    // Continue in the same direction: wrapping must still reach the live source.
+    workspace()->switchWindow(Workspace::Direction(direction));
+    QCOMPARE(workspace()->activeWindow(), source.m_window);
+#else
+    QSKIP("Requires Xwayland");
+#endif
+}
