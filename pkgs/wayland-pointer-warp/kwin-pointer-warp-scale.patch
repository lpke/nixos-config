+#if KWIN_BUILD_X11
+void TestPointerConstraints::testXwaylandPointerWarpDispatch()
+{
+    Test::XcbConnectionPtr connection = Test::createX11Connection();
+    QVERIFY(!xcb_connection_has_error(connection.get()));
+    const xcb_window_t windowId = xcb_generate_id(connection.get());
+    const uint32_t background = 0x0000ff;
+    xcb_create_window(connection.get(), XCB_COPY_FROM_PARENT, windowId, rootWindow(),
+                      0, 0, 100, 100, 0, XCB_WINDOW_CLASS_INPUT_OUTPUT, XCB_COPY_FROM_PARENT, XCB_CW_BACK_PIXEL, &background);
+    QSignalSpy windowAdded(workspace(), &Workspace::windowAdded);
+    xcb_map_window(connection.get(), windowId);
+    xcb_flush(connection.get());
+    QVERIFY(windowAdded.wait());
+    auto window = qobject_cast<X11Window *>(windowAdded.last().first().value<Window *>());
+    QVERIFY(window);
+    QMetaObject::invokeMethod(window, "setReadyForPainting");
+    QVERIFY(Test::waitForWaylandSurface(window));
+    SurfaceInterface *surface = window->surface();
+    QTRY_VERIFY(surface->boundingRect().contains(QPointF(23.5, 41.25) / surface->scaleOverride()));
+    QCOMPARE(surface->client(), waylandServer()->xWaylandConnection());
+    QVERIFY(!waylandServer()->findWindow(surface));
+    input()->pointer()->warp(window->bufferGeometry().center());
+    QCOMPARE(waylandServer()->seat()->pointer()->focusedSurface(), surface);
+    const uint32_t serial = waylandServer()->seat()->pointer()->focusedSerial();
+
+    // Dispatch the server signal using a real X11 window and its Xwayland-owned
+    // surface. A separate native client cannot name that client's wl_surface.
+    PointerInterface *serverPointer = waylandServer()->seat()->pointer();
+    const auto dispatchWarp = [&](const QPointF &point, uint32_t enterSerial) {
+        auto warp = waylandServer()->pointerWarp();
+        const int signal = warp->metaObject()->indexOfSignal("warpRequested(SurfaceInterface*,PointerInterface*,QPointF,uint32_t)");
+        if (signal < 0) {
+            return false;
+        }
+        return warp->metaObject()->method(signal).invoke(warp, Qt::DirectConnection,
+                                                         QGenericArgument("SurfaceInterface*", &surface),
+                                                         QGenericArgument("PointerInterface*", &serverPointer),
+                                                         QGenericArgument("QPointF", &point),
+                                                         QGenericArgument("uint32_t", &enterSerial));
+    };
+    const QPointF point(23.5, 41.25);
+    QVERIFY(dispatchWarp(point, serial));
+    QCOMPARE(Cursors::self()->mouse()->pos(), window->mapFromLocal(point / surface->scaleOverride()));
+    const QPointF before = Cursors::self()->mouse()->pos();
+    QVERIFY(dispatchWarp(QPointF(10, 20), serial - 1));
+    QCOMPARE(Cursors::self()->mouse()->pos(), before);
+
+    QSignalSpy closed(window, &Window::closed);
+    xcb_unmap_window(connection.get(), windowId);
+    xcb_destroy_window(connection.get(), windowId);
+    xcb_flush(connection.get());
+    QVERIFY(closed.wait());
+}
+#endif
