+void TestPointerConstraints::testProtocolPointerWarp_data()
+{
+    QTest::addColumn<qreal>("scale");
+    QTest::newRow("ordinary-client") << qreal(1.0);
+    QTest::newRow("scaled-client") << qreal(1.25);
+}
+
+void TestPointerConstraints::testProtocolPointerWarp()
+{
+    QFETCH(qreal, scale);
+
+    KWayland::Client::Registry registry;
+    registry.create(Test::waylandConnection());
+    QSignalSpy interfaceAnnounced(&registry, &KWayland::Client::Registry::interfaceAnnounced);
+    QSignalSpy allAnnounced(&registry, &KWayland::Client::Registry::interfacesAnnounced);
+    registry.setup();
+    QVERIFY(allAnnounced.wait());
+    uint32_t warpName = 0;
+    for (const auto &announcement : interfaceAnnounced) {
+        if (announcement[0].toByteArray() == QByteArrayLiteral("wp_pointer_warp_v1")) {
+            warpName = announcement[1].toUInt();
+            break;
+        }
+    }
+    QVERIFY(warpName);
+    QtWayland::wp_pointer_warp_v1 warp(registry.registry(), warpName, 1);
+    QVERIFY(warp.isInitialized());
+    const auto destroyWarp = qScopeGuard([&]() { warp.destroy(); });
+
+    std::unique_ptr<KWayland::Client::Surface> surface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> shellSurface(Test::createXdgToplevelSurface(surface.get()));
+    std::unique_ptr<KWayland::Client::Pointer> pointer(Test::waylandSeat()->createPointer());
+    auto window = Test::renderAndWaitForShown(surface.get(), QSize(100, 100), Qt::blue);
+    QVERIFY(window);
+    SurfaceInterface *serverSurface = window->surface();
+    serverSurface->client()->setScaleOverride(scale);
+    surface->commit(KWayland::Client::Surface::CommitFlag::None);
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(serverSurface->scaleOverride(), scale);
+    input()->pointer()->warp(window->frameGeometry().center());
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(waylandServer()->seat()->pointer()->focusedSurface(), serverSurface);
+    const uint32_t serial = waylandServer()->seat()->pointer()->focusedSerial();
+
+    // Send a real protocol request. At scale 1.25 the raw point is outside the
+    // compositor bounds but inside the client surface after coordinate conversion.
+    const QPointF point(90.5, 75.25);
+    warp.warp_pointer(*surface, *pointer, wl_fixed_from_double(point.x()), wl_fixed_from_double(point.y()), serial);
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(Cursors::self()->mouse()->pos(), window->mapFromLocal(point / scale));
+
+    const QPointF before = Cursors::self()->mouse()->pos();
+    warp.warp_pointer(*surface, *pointer, wl_fixed_from_int(10), wl_fixed_from_int(20), serial - 1);
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(Cursors::self()->mouse()->pos(), before);
+
+    warp.warp_pointer(*surface, *pointer, wl_fixed_from_int(101), wl_fixed_from_int(20), serial);
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(Cursors::self()->mouse()->pos(), before);
+    warp.warp_pointer(*surface, *pointer, wl_fixed_from_int(-1), wl_fixed_from_int(20), serial);
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(Cursors::self()->mouse()->pos(), before);
+}
