+static void portal_apply_filter(FileDialogImpl *This, UINT index)
+{
+    if (!index || index > This->filterspec_count || index - 1 == This->filetypeindex) return;
+    This->filetypeindex = index - 1;
+    set_current_filter(This, This->filterspecs[This->filetypeindex].pszSpec);
+    events_OnTypeChange(This);
+}
