-/* Signal filter to capture Response from portal */
+/* FileChooser returns the selected format separately from its URI. */
+static void parse_filter_result(struct portal_context *ctx, DBusMessageIter *variant)
+{
+    DBusMessageIter fields;
+    const char *selected, *cursor = ctx->filters_blob, *end;
+    const char *name, *pattern;
+    UINT index;
+
+    if (!ctx->filter_index || !cursor || p_dbus_message_iter_get_arg_type(variant) != DBUS_TYPE_STRUCT) return;
+    end = cursor + ctx->filters_len;
+    p_dbus_message_iter_recurse(variant, &fields);
+    if (p_dbus_message_iter_get_arg_type(&fields) != DBUS_TYPE_STRING) return;
+    p_dbus_message_iter_get_basic(&fields, &selected);
+    for (index = 1; index <= ctx->filter_count; index++)
+    {
+        if (!get_next_filter_pair(&cursor, end, &name, &pattern)) break;
+        if (!strcmp(name, selected))
+        {
+            *ctx->filter_index = index;
+            return;
+        }
+    }
+}
